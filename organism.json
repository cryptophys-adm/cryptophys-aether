{
  "$comment": "Aether's DNA (owner 2026-11-14: \"ya, Aether perlu DNA, tes CI, dan file yang dilindungi sendiri lebih dulu sebelum boleh diubah oleh agen\"). `organs` follows the platform's DNA schema (cryptophys-cloud-platform ADR-0013, control-plane-shared/src/organism.ts parseDna, the external-organ shape of xauusd-organism.v1). `anatomy` adds what the census does not read yet: entrypoints, bindings, storage, crons, models and callers. Each agent's `schedule` is the daily run of the scheduled handler that acts as it (owner 2026-11-14: \"jangan pensiun aether calibrator karena cara kerjanya memang idle sampai jadwalnya kerja\"). The platform Forge reads this file through the RPC entrypoint OrganismDna (dna(), owner 2026-11-14: \"naikan batas kapabilitas aether\"). test/organism-dna.test.mjs keeps every entry equal to wrangler.jsonc and src/. This file is a guard path (guard-paths.json): a change needs the owner's merge.",
  "schema": "aether-organism.v1",
  "organs": [
    {
      "$schema_version": 1,
      "service": "cryptophys-aether",
      "display_name": "Aether",
      "kind": "service",
      "deploy_unit": null,
      "access": false,
      "rollback": false,
      "drift": {
        "via": "rpc",
        "binding": "EXT_AETHER"
      },
      "agents": [
        {
          "id": "aether-guardian",
          "display_name": "Aether Guardian",
          "capabilities": [
            "signals.observe",
            "reports.publish"
          ],
          "tier_max": 1,
          "voter": false,
          "schedule": {
            "cron": "52 1 * * *"
          }
        },
        {
          "id": "aether-auditor",
          "display_name": "Aether Auditor",
          "capabilities": [
            "signals.observe",
            "reports.publish"
          ],
          "tier_max": 1,
          "voter": false,
          "schedule": {
            "cron": "52 1 * * *"
          }
        },
        {
          "id": "aether-curator",
          "display_name": "Aether Curator",
          "capabilities": [
            "reports.publish",
            "knowledge.propose",
            "knowledge.status"
          ],
          "tier_max": 1,
          "voter": false,
          "schedule": {
            "cron": "52 2 * * *"
          }
        },
        {
          "id": "aether-calibrator",
          "display_name": "Aether Calibrator",
          "capabilities": [
            "reports.publish",
            "knowledge.propose",
            "knowledge.status"
          ],
          "tier_max": 1,
          "voter": false,
          "schedule": {
            "cron": "52 2 * * *"
          }
        },
        {
          "id": "knowledge-council",
          "display_name": "Knowledge Council",
          "capabilities": [
            "consensus.propose",
            "doctrine.status",
            "reports.publish"
          ],
          "tier_max": 1,
          "voter": false,
          "schedule": {
            "cron": "52 3 * * *"
          }
        }
      ],
      "engines": [
        {
          "task": "embed_texts"
        }
      ]
    }
  ],
  "anatomy": {
    "cryptophys-aether": {
      "wrangler": "wrangler.jsonc",
      "main": "src/index.mjs",
      "compatibility_date": "2026-10-31",
      "surface": {
        "workers_dev": false,
        "preview_urls": false,
        "routes": [],
        "observability": true
      },
      "entrypoints": [
        {
          "name": "default",
          "kind": "fetch",
          "methods": ["GET", "HEAD"],
          "paths": ["/", "/health", "/canon", "/v1/overview"],
          "callers": [
            { "service": "cryptophys-console", "binding": "AETHER", "use": "GET /v1/overview" },
            { "service": "cryptophys-drift-detector", "binding": "EXT_AETHER", "use": "GET /health" }
          ]
        },
        {
          "name": "default",
          "kind": "scheduled"
        },
        {
          "name": "KnowledgeIngress",
          "kind": "rpc",
          "methods": ["ingestCards", "canonInfo", "learnedPack", "omegaPolicy", "ingestWeightingReport", "ingestDoctrineFacts", "ingestExecutionReport", "ingestModelReport", "lensPolicy", "ingestLensReport"],
          "callers": [
            { "service": "xauusd-ai-trading-assistant", "binding": "AETHER" }
          ]
        },
        {
          "name": "AetherReader",
          "kind": "rpc",
          "methods": ["overview", "sync"],
          "callers": [
            { "service": "xauusd-nexus-dashboard", "binding": "AETHER" },
            { "service": "xauusd-ai-trading-assistant", "binding": "AETHER_READER" }
          ]
        },
        {
          "name": "OrganismDna",
          "kind": "rpc",
          "methods": ["dna"],
          "callers": [
            { "service": "cryptophys-forge", "binding": "EXT_ORGANISM_AETHER" }
          ]
        }
      ],
      "bindings": [
        { "binding": "AETHER_DB", "type": "d1", "database_name": "aether-knowledge" },
        { "binding": "CANON_INDEX", "type": "vectorize", "index_name": "aether-canon" },
        { "binding": "MARKET_INDEX", "type": "vectorize", "index_name": "aether-market" },
        { "binding": "AI", "type": "ai" },
        { "binding": "AGENTS", "type": "service", "service": "cryptophys-ai-kernel", "entrypoint": "AgentRpc", "props": { "host_worker": "cryptophys-aether" } }
      ],
      "vars": {
        "AETHER_PHASE": "A6",
        "KNOWLEDGE_COUNCIL": "propose"
      },
      "code_defaults": {
        "KNOWLEDGE_AUTO_SHADOW": "on"
      },
      "storage": {
        "d1": [
          {
            "binding": "AETHER_DB",
            "database_name": "aether-knowledge",
            "provisioned_by": "wrangler automatic resource provisioning (no database_id in wrangler.jsonc)",
            "schema": "runtime (CREATE TABLE IF NOT EXISTS in src/)",
            "tables": ["aether_meta", "ai_usage", "canon_vectors", "council_proposals", "council_sessions", "decision_cards", "doctrine_applied", "doctrine_facts", "execution_reports", "ingest_log", "knowledge_items", "lens_reports", "model_reports", "weighting_reports", "weighting_reports_tf"]
          }
        ],
        "vectorize": [
          { "binding": "CANON_INDEX", "index_name": "aether-canon", "dimensions": 384, "metric": "cosine", "metadata": [["part", "string"], ["canon", "string"]], "provisioned_by": "scripts/ensure-vectorize.mjs" },
          { "binding": "MARKET_INDEX", "index_name": "aether-market", "dimensions": 384, "metric": "cosine", "metadata": [["kind", "string"], ["chart", "string"], ["session", "string"], ["stance", "string"], ["day", "number"]], "provisioned_by": "scripts/ensure-vectorize.mjs" }
        ],
        "kv_namespaces": [],
        "r2_buckets": [],
        "durable_objects": [],
        "queues": []
      },
      "models": [
        {
          "task": "embed_texts",
          "binding": "AI",
          "model": "@cf/baai/bge-small-en-v1.5",
          "dimensions": 384,
          "batch": 50,
          "budget": null,
          "metering": { "table": "ai_usage", "unit": "requests", "per": "utc_day", "module": "src/usage.mjs" },
          "used_by": ["embedPendingCards", "syncCanon"]
        }
      ],
      "outbound": [
        { "binding": "AGENTS", "service": "cryptophys-ai-kernel", "entrypoint": "AgentRpc", "methods": ["syscall"] }
      ],
      "crons": ["52 * * * *"],
      "schedule": [
        { "step": "canon_sync", "utc_hour": null },
        { "step": "embed_cards", "utc_hour": null },
        { "step": "knowledge_reviews", "utc_hour": null },
        { "step": "doctrine_amendments", "utc_hour": null },
        { "step": "digest", "utc_hour": 1 },
        { "step": "curation", "utc_hour": 2 },
        { "step": "curation_carry", "utc_hour": null },
        { "step": "knowledge_council", "utc_hour": 3 }
      ],
      "agents": [
        { "id": "aether-guardian", "module": "src/guardian.mjs", "uses": ["reports.publish"], "registered_by": "cryptophys-cloud-platform migration 0027" },
        { "id": "aether-auditor", "module": "src/guardian.mjs", "uses": ["reports.publish"], "registered_by": "cryptophys-cloud-platform migration 0027" },
        { "id": "aether-curator", "module": "src/knowledge.mjs", "uses": ["knowledge.propose", "knowledge.status", "reports.publish"], "registered_by": "cryptophys-cloud-platform migrations 0027, 0029" },
        { "id": "aether-calibrator", "module": "src/knowledge.mjs", "uses": ["knowledge.propose", "knowledge.status", "reports.publish"], "registered_by": "cryptophys-cloud-platform migrations 0027, 0029" },
        { "id": "knowledge-council", "module": "src/doctrine.mjs", "uses": ["consensus.propose", "doctrine.status", "reports.publish"], "registered_by": "cryptophys-cloud-platform migration 0045" }
      ]
    }
  }
}
